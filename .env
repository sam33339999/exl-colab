# Default model file. ./start.sh loads this when ENV_FILE is unset.
# This copy matches .env.coder390.
# One launch:
#   ENV_FILE=.env.swift ./start.sh --bg
#   ENV_FILE=.env.coder390 ./start.sh --bg
# Change the default:
#   cp .env.swift .env
#   cp .env.coder390 .env
# A MODEL_* or DRAFT_* value already exported in the shell wins over this file.
MODEL_REPO=sam33339999/Qwen3.8-27B-Coder390-MTP-Exl3-3.5bpw
MODEL_NAME=Qwen3.8-27B-Coder390-MTP-Exl3-3.5bpw

# Loaded only when DRAFT=dflash2. Leave DRAFT unset to keep MTP from config.yml.
DRAFT_REPO=sam33339999/Qwen3.8-27B-Coder390-dflash2
DRAFT_NAME=Qwen3.8-27B-Coder390-dflash2
