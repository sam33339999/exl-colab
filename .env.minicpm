# MiniCPM-V 4.7 EXL3. Launch with:
#   ENV_FILE=.env.minicpm ./start.sh --bg
# Weights live in models/minicpm-4.7-35b-a3b. The adapter wheel is installed
# in tabbyAPI/.venv. This checkpoint has no MTP head, so drafting stays off.
MODEL_REPO=BlackwellBoy/MiniCPM-V-4.7-35B-A3B-Derived-EXL3-4bpw
MODEL_NAME=minicpm-4.7-35b-a3b
DRAFT=off
# A100 40GB. 32768 is above the published 8192 qualification and under the
# 256K text run that peaked near 26 GiB. Raise max_seq_len and cache_size
# together. cache_size must be a multiple of 256 and at least max_seq_len.
# Batch stays 1: the vision bridge packs a single request.
TABBY_MODEL_MAX_SEQ_LEN=32768
TABBY_MODEL_CACHE_SIZE=32768
TABBY_MODEL_MAX_BATCH_SIZE=1
