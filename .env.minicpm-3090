# This 3090, this directory. Launch with:
#   ./start-minicpm-3090.sh --bg
# Do not use .env.minicpm. That file points at a different 4bpw checkpoint
# and start.sh would download it. This file never names a Hugging Face repo
# that should be fetched into the weight directory.
MODEL_REPO=LOCAL_ONLY_DO_NOT_DOWNLOAD
MODEL_NAME=MiniCPM-V-4.7-35B-A3B-abliterated-EXL3-3.5bpw
MODEL_DIR=/home/sam/MiniCPM-V-4.7-35B-A3B-abliterated-EXL3-3.5bpw
DRAFT=off
# Tabby joins model_dir / model_name. The folder name is MODEL_NAME, so the
# parent directory is the model_dir. start.sh sets TABBY_MODEL_MODEL_NAME
# from MODEL_NAME and does not set this path.
TABBY_MODEL_MODEL_DIR=/home/sam
# config.yml is the A100 recipe (262144 context, Q8, batch 8, 24 GiB of
# pinned KV). These replace that memory section. Context, cache, batch and
# vision are in the weight directory's tabby_config.yml, which wins at load.
TABBY_MEMORY_SYSMEM_KV_CACHE=0
TABBY_MEMORY_SYSMEM_RECURRENT_CACHE=4096
TABBY_MEMORY_SYSMEM_MULTIMODAL_CACHE=0
