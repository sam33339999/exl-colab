# DaisyRose-27B EXL3 6.00bpw. The Qwen MTP head is in this checkpoint at 6 bits.
# One launch:     ENV_FILE=.env.daisyrose ./start.sh --bg
# Make it default: cp .env.daisyrose .env
# MODEL_NAME is the /v1/models id and the weights folder name.
#
# Disk size is 21.2 GiB. config.yml's 393216 Q8 cache is the 3.5bpw recipe
# and does not fit beside these weights on the 40GB A100. 131072 is one 128K
# request. cache_size must be a multiple of 256 and at least max_seq_len.
# Raise both together if nvidia-smi still shows several GB free after load.
MODEL_REPO=TendieLabs/DaisyRose-27B-exl3-6.00bpw-Qwen-MTP6
MODEL_NAME=DaisyRose-27B-exl3-6.00bpw-Qwen-MTP6
# Checkpoint MTP. Unset DRAFT would also keep config.yml's mtp / 4 tokens.
DRAFT=mtp
TABBY_MODEL_MAX_SEQ_LEN=131072
TABBY_MODEL_CACHE_SIZE=131072
TABBY_MODEL_MAX_BATCH_SIZE=4
